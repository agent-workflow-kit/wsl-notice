{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "wsl-notice/defs.json",
  "title": "wsl-notice shared definitions",
  "description": "Not an output on its own. Shared definitions referenced by the notification, CLI and log schemas. config.json embeds its own copies.",
  "$defs": {
    "level": {
      "enum": [
        "info",
        "warn",
        "action",
        "error"
      ],
      "description": "Ordered info < warn < action < error; the order matters to callers, not to wsl-notice."
    },
    "ts": {
      "type": "string",
      "format": "date-time",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}\\.[0-9]{3}Z(?![\\s\\S])",
      "description": "UTC, YYYY-MM-DDTHH:MM:SS.mmmZ."
    },
    "hex16": {
      "type": "string",
      "pattern": "^[0-9a-f]{16}(?![\\s\\S])",
      "description": "First 16 hex characters of a SHA-256."
    },
    "dedupe_key": {
      "type": "string",
      "minLength": 1,
      "maxLength": 1024,
      "description": "A caller's --dedupe-key: any non-empty string of at most 1024 characters. Only hashed in the log; no effect on the toast in 0.x."
    },
    "actor": {
      "type": "string",
      "pattern": "^(human|auto):[A-Za-z0-9._@/-]{1,64}(?![\\s\\S])",
      "description": "human:<user> or auto:<name>. Advisory against same-user processes."
    },
    "actor_source": {
      "enum": [
        "flag",
        "tty",
        "default"
      ],
      "description": "flag: --actor; tty: human:<user> because stdin is a terminal; default: auto:unknown."
    },
    "stage": {
      "type": "string",
      "pattern": "^(decode|json|xml|show|unknown)(?![\\s\\S])",
      "description": "The constant script's failure token, unknown for exit 3 with other stderr."
    },
    "exit_code": {
      "enum": [
        0,
        1,
        2,
        12,
        20,
        22
      ]
    },
    "error_code": {
      "enum": [
        "internal",
        "usage",
        "config_invalid",
        "refused",
        "not_wsl",
        "tool_missing",
        "toast_failed",
        "interop_failed",
        "unavailable",
        "outcome_unknown"
      ]
    },
    "refusal_reason": {
      "enum": [
        "invalid_payload",
        "empty_message",
        "link_invalid",
        "link_scheme"
      ]
    },
    "rendered": {
      "type": "object",
      "description": "The JSON object handed to PowerShell (base64 of it travels on stdin).",
      "properties": {
        "title": {
          "type": [
            "string",
            "null"
          ],
          "maxLength": 273,
          "x-untrusted": true
        },
        "body": {
          "type": "string",
          "minLength": 1,
          "maxLength": 5000,
          "x-untrusted": true
        },
        "launch": {
          "type": [
            "string",
            "null"
          ],
          "x-untrusted": true,
          "description": "The link with a lowercased scheme, http or https only; null when absent."
        },
        "app_id": {
          "type": "string",
          "pattern": "^[A-Za-z0-9_.{}\\\\ -]{1,256}(?![\\s\\S])"
        }
      },
      "required": [
        "title",
        "body",
        "launch",
        "app_id"
      ],
      "additionalProperties": false
    },
    "error": {
      "type": "object",
      "properties": {
        "code": {
          "$ref": "defs.json#/$defs/error_code"
        },
        "message": {
          "type": "string",
          "x-untrusted": true,
          "description": "A fixed string of the tool; never exception text, child output or an input value."
        },
        "reason": {
          "oneOf": [
            {
              "$ref": "defs.json#/$defs/refusal_reason"
            },
            {
              "type": "null"
            }
          ],
          "description": "Set on exit 20 (code refused); null elsewhere."
        },
        "details": {
          "type": [
            "object",
            "null"
          ],
          "description": "Fixed strings and numbers only, by code or reason: config_invalid has key (a config key name, ?, --config, home or a file path); unavailable has phase (always input); reason invalid_payload has pointer; reason link_invalid has pointer /link; tool_missing has install; toast_failed has stage and attempts; interop_failed has attempts; outcome_unknown has attempts and exit_status. Never an input value."
        },
        "retryable": {
          "type": [
            "boolean",
            "null"
          ],
          "description": "Boolean on exit 12 and exit 1 (false); null on exit 2 and exit 20."
        },
        "retry_after_s": {
          "type": "null",
          "description": "Always null in wsl-notice."
        },
        "unknown_outcome": {
          "type": [
            "boolean",
            "null"
          ],
          "description": "Boolean on exit 12 and exit 1; null on exit 2 and exit 20. True when the toast may already have been shown."
        }
      },
      "required": [
        "code",
        "message"
      ],
      "additionalProperties": false,
      "allOf": [
        {
          "if": {
            "properties": {
              "code": {
                "const": "refused"
              }
            },
            "required": [
              "code"
            ]
          },
          "then": {
            "required": [
              "reason"
            ],
            "properties": {
              "reason": {
                "$ref": "defs.json#/$defs/refusal_reason"
              }
            }
          },
          "else": {
            "properties": {
              "reason": {
                "type": "null"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "code": {
                "enum": [
                  "not_wsl",
                  "tool_missing",
                  "toast_failed",
                  "interop_failed",
                  "unavailable",
                  "outcome_unknown"
                ]
              }
            },
            "required": [
              "code"
            ]
          },
          "then": {
            "required": [
              "retryable",
              "unknown_outcome"
            ],
            "properties": {
              "retryable": {
                "type": "boolean"
              },
              "unknown_outcome": {
                "type": "boolean"
              }
            }
          },
          "else": {
            "if": {
              "properties": {
                "code": {
                  "const": "internal"
                }
              },
              "required": [
                "code"
              ]
            },
            "then": {
              "properties": {
                "retryable": {
                  "const": false
                },
                "unknown_outcome": {
                  "type": "boolean"
                }
              }
            },
            "else": {
              "properties": {
                "retryable": {
                  "type": "null"
                },
                "unknown_outcome": {
                  "type": "null"
                }
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "code": {
                "const": "toast_failed"
              }
            },
            "required": [
              "code"
            ]
          },
          "then": {
            "properties": {
              "retryable": {
                "const": false
              },
              "unknown_outcome": {
                "const": false
              }
            },
            "required": [
              "details"
            ],
            "$comment": "details.stage and details.attempts are required."
          }
        },
        {
          "if": {
            "properties": {
              "code": {
                "const": "interop_failed"
              }
            },
            "required": [
              "code"
            ]
          },
          "then": {
            "properties": {
              "retryable": {
                "const": true
              },
              "unknown_outcome": {
                "const": false
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "code": {
                "const": "unavailable"
              }
            },
            "required": [
              "code"
            ]
          },
          "then": {
            "properties": {
              "retryable": {
                "const": true
              },
              "unknown_outcome": {
                "const": false
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "code": {
                "const": "outcome_unknown"
              }
            },
            "required": [
              "code"
            ]
          },
          "then": {
            "properties": {
              "retryable": {
                "const": false
              },
              "unknown_outcome": {
                "const": true
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "code": {
                "enum": [
                  "tool_missing",
                  "not_wsl"
                ]
              }
            },
            "required": [
              "code"
            ]
          },
          "then": {
            "properties": {
              "retryable": {
                "const": false
              },
              "unknown_outcome": {
                "const": false
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "code": {
                "const": "config_invalid"
              }
            },
            "required": [
              "code"
            ]
          },
          "then": {
            "required": [
              "details"
            ],
            "properties": {
              "details": {
                "type": "object",
                "required": [
                  "key"
                ],
                "properties": {
                  "key": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 4096
                  }
                }
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "code": {
                "const": "tool_missing"
              }
            },
            "required": [
              "code"
            ]
          },
          "then": {
            "required": [
              "details"
            ],
            "properties": {
              "details": {
                "type": "object",
                "required": [
                  "install"
                ],
                "properties": {
                  "install": {
                    "const": "Set powershell_bin to the absolute path of Windows PowerShell 5.1, enable interop ([interop] enabled=true in /etc/wsl.conf) and check the automount root."
                  }
                }
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "code": {
                "const": "unavailable"
              }
            },
            "required": [
              "code"
            ]
          },
          "then": {
            "required": [
              "details"
            ],
            "properties": {
              "details": {
                "type": "object",
                "required": [
                  "phase"
                ],
                "properties": {
                  "phase": {
                    "const": "input"
                  }
                }
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "code": {
                "const": "toast_failed"
              }
            },
            "required": [
              "code"
            ]
          },
          "then": {
            "required": [
              "details"
            ],
            "properties": {
              "details": {
                "type": "object",
                "required": [
                  "stage"
                ],
                "properties": {
                  "stage": {
                    "$ref": "#/$defs/stage"
                  }
                }
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "code": {
                "const": "toast_failed"
              }
            },
            "required": [
              "code"
            ]
          },
          "then": {
            "required": [
              "details"
            ],
            "properties": {
              "details": {
                "type": "object",
                "required": [
                  "attempts"
                ],
                "properties": {
                  "attempts": {
                    "enum": [
                      1,
                      2
                    ]
                  }
                }
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "code": {
                "const": "interop_failed"
              }
            },
            "required": [
              "code"
            ]
          },
          "then": {
            "required": [
              "details"
            ],
            "properties": {
              "details": {
                "type": "object",
                "required": [
                  "attempts"
                ],
                "properties": {
                  "attempts": {
                    "enum": [
                      1,
                      2,
                      null
                    ]
                  }
                }
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "code": {
                "const": "outcome_unknown"
              }
            },
            "required": [
              "code"
            ]
          },
          "then": {
            "required": [
              "details"
            ],
            "properties": {
              "details": {
                "type": "object",
                "required": [
                  "attempts"
                ],
                "properties": {
                  "attempts": {
                    "enum": [
                      1,
                      2
                    ]
                  }
                }
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "code": {
                "const": "outcome_unknown"
              }
            },
            "required": [
              "code"
            ]
          },
          "then": {
            "properties": {
              "details": {
                "required": [
                  "exit_status"
                ],
                "properties": {
                  "exit_status": {
                    "type": [
                      "integer",
                      "null"
                    ],
                    "description": "Exit status of the child, negative for a signal; null when the deadline ended it."
                  }
                }
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "reason": {
                "const": "link_invalid"
              }
            },
            "required": [
              "reason"
            ]
          },
          "then": {
            "required": [
              "details"
            ],
            "properties": {
              "details": {
                "type": "object",
                "required": [
                  "pointer"
                ],
                "properties": {
                  "pointer": {
                    "const": "/link"
                  }
                }
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "reason": {
                "const": "invalid_payload"
              }
            },
            "required": [
              "reason"
            ]
          },
          "then": {
            "required": [
              "details"
            ],
            "properties": {
              "details": {
                "type": "object",
                "required": [
                  "pointer"
                ],
                "properties": {
                  "pointer": {
                    "type": "string",
                    "pattern": "^(|/[A-Za-z0-9_-]{1,64}|/\\?)(?![\\s\\S])"
                  }
                }
              }
            }
          }
        }
      ]
    }
  }
}
