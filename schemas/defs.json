{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "wsl-notice/defs.json",
  "title": "wsl-notice shared definitions",
  "description": "Not an output on its own. Shared definitions referenced by the notification, CLI and log schemas. config.json embeds its own copies.",
  "$defs": {
    "level": {
      "enum": [
        "info",
        "warn",
        "action",
        "error"
      ],
      "description": "Ordered info < warn < action < error; the order matters to callers, not to wsl-notice."
    },
    "ts": {
      "type": "string",
      "format": "date-time",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}[Tt][0-9]{2}:[0-9]{2}:[0-9]{2}(?:\\.[0-9]+)?(?:[Zz]|[+-][0-9]{2}:[0-9]{2})$",
      "description": "RFC 3339."
    },
    "hex16": {
      "type": "string",
      "pattern": "^[0-9a-f]{16}$",
      "description": "First 16 hex characters of a SHA-256."
    },
    "dedupe_key": {
      "type": "string",
      "pattern": "^[A-Za-z0-9._:@/-]{1,128}$",
      "description": "A caller's --dedupe-key. Accepted and recorded (hashed) in the log; no effect on the toast in 0.x."
    },
    "actor": {
      "type": "string",
      "pattern": "^(human|auto):[A-Za-z0-9._@-]{1,64}$",
      "description": "human:<user> or auto:<name>. Advisory against same-user processes."
    },
    "actor_source": {
      "enum": [
        "flag",
        "tty",
        "default"
      ],
      "description": "flag: --actor; tty: human:<user> because stdin is a terminal; default: auto:unknown."
    },
    "exit_code": {
      "enum": [
        0,
        1,
        2,
        12,
        20,
        22
      ]
    },
    "error_code": {
      "enum": [
        "internal",
        "usage",
        "config_invalid",
        "refused",
        "tool_missing",
        "toast_failed",
        "interop_failed",
        "outcome_unknown",
        "state_unsafe"
      ]
    },
    "refusal_reason": {
      "enum": [
        "invalid_payload",
        "empty_message",
        "link_invalid",
        "link_scheme",
        "not_wsl"
      ]
    },
    "rendered": {
      "type": "object",
      "description": "The JSON object handed to PowerShell (base64 of it travels on stdin).",
      "properties": {
        "title": {
          "type": [
            "string",
            "null"
          ],
          "x-untrusted": true
        },
        "body": {
          "type": "string",
          "minLength": 1,
          "x-untrusted": true
        },
        "launch": {
          "type": [
            "string",
            "null"
          ],
          "x-untrusted": true,
          "description": "The link, http or https only; null when absent."
        },
        "app_id": {
          "type": "string",
          "pattern": "^[A-Za-z0-9_.{}\\\\ -]{1,256}$"
        }
      },
      "required": [
        "title",
        "body",
        "launch",
        "app_id"
      ],
      "additionalProperties": false
    },
    "error": {
      "type": "object",
      "properties": {
        "code": {
          "$ref": "defs.json#/$defs/error_code"
        },
        "message": {
          "type": "string",
          "x-untrusted": true,
          "description": "Untrusted: may echo input or tool output."
        },
        "reason": {
          "oneOf": [
            {
              "$ref": "defs.json#/$defs/refusal_reason"
            },
            {
              "type": "null"
            }
          ],
          "description": "On exit 20 (code refused)."
        },
        "details": {
          "type": [
            "object",
            "null"
          ],
          "x-untrusted": true,
          "description": "By code: config_invalid has key; invalid_payload has pointer; tool_missing has install; toast_failed has stage."
        },
        "retryable": {
          "type": [
            "boolean",
            "null"
          ],
          "description": "Exit 12 only."
        },
        "retry_after_s": {
          "type": "null",
          "description": "Always null in wsl-notice."
        },
        "unknown_outcome": {
          "type": [
            "boolean",
            "null"
          ],
          "description": "Exit 12 only; true when the toast may or may not have been shown."
        }
      },
      "required": [
        "code",
        "message"
      ],
      "additionalProperties": false,
      "allOf": [
        {
          "if": {
            "properties": {
              "code": {
                "const": "refused"
              }
            },
            "required": [
              "code"
            ]
          },
          "then": {
            "required": [
              "reason"
            ],
            "properties": {
              "reason": {
                "$ref": "defs.json#/$defs/refusal_reason"
              }
            }
          },
          "else": {
            "properties": {
              "reason": {
                "type": "null"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "code": {
                "enum": [
                  "tool_missing",
                  "toast_failed",
                  "interop_failed",
                  "outcome_unknown",
                  "state_unsafe"
                ]
              }
            },
            "required": [
              "code"
            ]
          },
          "then": {
            "required": [
              "retryable",
              "unknown_outcome"
            ],
            "properties": {
              "retryable": {
                "type": "boolean"
              },
              "unknown_outcome": {
                "type": "boolean"
              }
            }
          },
          "else": {
            "properties": {
              "retryable": {
                "type": "null"
              },
              "unknown_outcome": {
                "type": "null"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "code": {
                "const": "toast_failed"
              }
            },
            "required": [
              "code"
            ]
          },
          "then": {
            "properties": {
              "retryable": {
                "const": false
              },
              "unknown_outcome": {
                "const": false
              }
            },
            "required": [
              "details"
            ],
            "$comment": "details.stage is required."
          }
        },
        {
          "if": {
            "properties": {
              "code": {
                "const": "interop_failed"
              }
            },
            "required": [
              "code"
            ]
          },
          "then": {
            "properties": {
              "retryable": {
                "const": true
              },
              "unknown_outcome": {
                "const": false
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "code": {
                "const": "outcome_unknown"
              }
            },
            "required": [
              "code"
            ]
          },
          "then": {
            "properties": {
              "retryable": {
                "const": true
              },
              "unknown_outcome": {
                "const": true
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "code": {
                "enum": [
                  "tool_missing",
                  "state_unsafe"
                ]
              }
            },
            "required": [
              "code"
            ]
          },
          "then": {
            "properties": {
              "unknown_outcome": {
                "const": false
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "code": {
                "const": "config_invalid"
              }
            },
            "required": [
              "code"
            ]
          },
          "then": {
            "required": [
              "details"
            ],
            "properties": {
              "details": {
                "type": "object",
                "required": [
                  "key"
                ],
                "properties": {
                  "key": {
                    "type": "string",
                    "minLength": 1
                  }
                }
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "code": {
                "const": "tool_missing"
              }
            },
            "required": [
              "code"
            ]
          },
          "then": {
            "required": [
              "details"
            ],
            "properties": {
              "details": {
                "type": "object",
                "required": [
                  "install"
                ],
                "properties": {
                  "install": {
                    "type": "string",
                    "minLength": 1
                  }
                }
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "code": {
                "const": "toast_failed"
              }
            },
            "required": [
              "code"
            ]
          },
          "then": {
            "required": [
              "details"
            ],
            "properties": {
              "details": {
                "type": "object",
                "required": [
                  "stage"
                ],
                "properties": {
                  "stage": {
                    "type": "string",
                    "minLength": 1
                  }
                }
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "reason": {
                "const": "invalid_payload"
              }
            },
            "required": [
              "reason"
            ]
          },
          "then": {
            "required": [
              "details"
            ],
            "properties": {
              "details": {
                "type": "object",
                "required": [
                  "pointer"
                ],
                "properties": {
                  "pointer": {
                    "type": "string"
                  }
                }
              }
            }
          }
        }
      ]
    }
  }
}
