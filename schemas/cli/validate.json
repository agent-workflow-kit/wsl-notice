{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "wsl-notice/cli/validate.json",
  "title": "validate output",
  "description": "Printed with --json. ok is true only when every check passes (exit 0); on a failed check it is printed with ok false and the exit code is 2, 20 or 12.",
  "type": "object",
  "properties": {
    "ok": {
      "type": "boolean"
    },
    "checks": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9_]{0,63}$"
          },
          "ok": {
            "type": "boolean"
          },
          "message": {
            "type": "string",
            "x-untrusted": true
          }
        },
        "required": [
          "name",
          "ok",
          "message"
        ],
        "additionalProperties": false
      }
    },
    "powershell_version": {
      "type": "string",
      "x-untrusted": true,
      "description": "With --probe only."
    },
    "start_ms": {
      "type": "integer",
      "minimum": 0,
      "description": "With --probe only."
    }
  },
  "required": [
    "ok",
    "checks"
  ],
  "additionalProperties": false,
  "allOf": [
    {
      "if": {
        "properties": {
          "ok": {
            "const": true
          }
        },
        "required": [
          "ok"
        ]
      },
      "then": {
        "properties": {
          "checks": {
            "items": {
              "properties": {
                "ok": {
                  "const": true
                }
              }
            }
          }
        }
      },
      "else": {
        "properties": {
          "checks": {
            "contains": {
              "properties": {
                "ok": {
                  "const": false
                }
              },
              "required": [
                "ok"
              ]
            }
          }
        }
      }
    }
  ]
}
