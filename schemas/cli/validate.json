{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "wsl-notice/cli/validate.json",
  "title": "validate output",
  "description": "Printed with --json when the config loads. validate never prompts. A failed check ends the run, so ok is true only when every printed check is ok (exit 0); otherwise ok is false and the exit code is that of the failing check (12 or 20). When the config cannot load, the error envelope is printed instead (exit 2). With --probe: powershell_version and start_ms; with --test-message: a check named test_message. A disabled tool with --probe or --test-message prints {outcome: disabled} (send.json) and exits 22.",
  "type": "object",
  "properties": {
    "ok": {
      "type": "boolean"
    },
    "enabled": {
      "type": "boolean",
      "description": "The configured value."
    },
    "checks": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "name": {
            "enum": [
              "config",
              "platform",
              "powershell",
              "probe",
              "test_message"
            ],
            "description": "In this order; a failed check ends the run."
          },
          "ok": {
            "type": "boolean"
          },
          "message": {
            "type": "string",
            "x-untrusted": true
          }
        },
        "required": [
          "name",
          "ok",
          "message"
        ],
        "additionalProperties": false
      }
    },
    "powershell_version": {
      "type": "string",
      "x-untrusted": true,
      "description": "With --probe only."
    },
    "start_ms": {
      "type": "integer",
      "minimum": 0,
      "description": "With --probe only."
    }
  },
  "required": [
    "ok",
    "enabled",
    "checks"
  ],
  "additionalProperties": false,
  "dependentRequired": {
    "powershell_version": [
      "start_ms"
    ],
    "start_ms": [
      "powershell_version"
    ]
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "ok": {
            "const": true
          }
        },
        "required": [
          "ok"
        ]
      },
      "then": {
        "properties": {
          "checks": {
            "items": {
              "properties": {
                "ok": {
                  "const": true
                }
              }
            }
          }
        }
      },
      "else": {
        "properties": {
          "checks": {
            "contains": {
              "properties": {
                "ok": {
                  "const": false
                }
              },
              "required": [
                "ok"
              ]
            }
          }
        }
      }
    }
  ]
}
