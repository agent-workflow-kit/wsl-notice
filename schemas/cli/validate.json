{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "wsl-notice/cli/validate.json",
  "title": "validate output",
  "description": "Printed with --json when the config loads. ok is true only when every check passes (exit 0); otherwise it is printed with ok false and the exit code of the first failing check (20 with a reason, 12 for tool or host problems). When the config cannot load, the error envelope is printed instead (exit 2). With --probe: powershell_version and start_ms; with --test-message: a check named test_message.",
  "type": "object",
  "properties": {
    "ok": {
      "type": "boolean"
    },
    "checks": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9_]{0,63}$",
            "description": "For example config, wsl, powershell, test_message (the --test-message result)."
          },
          "ok": {
            "type": "boolean"
          },
          "message": {
            "type": "string",
            "x-untrusted": true
          }
        },
        "required": [
          "name",
          "ok",
          "message"
        ],
        "additionalProperties": false
      }
    },
    "powershell_version": {
      "type": "string",
      "x-untrusted": true,
      "description": "With --probe only."
    },
    "start_ms": {
      "type": "integer",
      "minimum": 0,
      "description": "With --probe only."
    }
  },
  "required": [
    "ok",
    "checks"
  ],
  "additionalProperties": false,
  "dependentRequired": {
    "powershell_version": [
      "start_ms"
    ],
    "start_ms": [
      "powershell_version"
    ]
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "ok": {
            "const": true
          }
        },
        "required": [
          "ok"
        ]
      },
      "then": {
        "properties": {
          "checks": {
            "items": {
              "properties": {
                "ok": {
                  "const": true
                }
              }
            }
          }
        }
      },
      "else": {
        "properties": {
          "checks": {
            "contains": {
              "properties": {
                "ok": {
                  "const": false
                }
              },
              "required": [
                "ok"
              ]
            }
          }
        }
      }
    }
  ]
}
