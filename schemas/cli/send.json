{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "wsl-notice/cli/send.json",
  "title": "send output",
  "description": "Printed with --json on exit 0 and on exit 22 (outcome disabled, nothing else; attempts is null for a dry run). Without --json stdout is empty. A refusal or failure prints the error envelope.",
  "type": "object",
  "properties": {
    "outcome": {
      "enum": [
        "sent",
        "dry_run",
        "disabled"
      ]
    },
    "tool": {
      "const": "wsl-notice"
    },
    "level": {
      "$ref": "../defs.json#/$defs/level"
    },
    "truncated": {
      "type": "boolean"
    },
    "bytes": {
      "type": "integer",
      "minimum": 0,
      "description": "Size of the JSON handed to PowerShell."
    },
    "duration_ms": {
      "type": "integer",
      "minimum": 0
    },
    "attempts": {
      "enum": [
        1,
        2,
        null
      ],
      "description": "1 or 2; null for a dry run."
    },
    "dedupe_key": {
      "oneOf": [
        {
          "$ref": "../defs.json#/$defs/dedupe_key"
        },
        {
          "type": "null"
        }
      ]
    },
    "rendered": {
      "$ref": "../defs.json#/$defs/rendered",
      "description": "Present only for a dry run."
    }
  },
  "required": [
    "outcome"
  ],
  "additionalProperties": false,
  "allOf": [
    {
      "if": {
        "properties": {
          "outcome": {
            "const": "sent"
          }
        },
        "required": [
          "outcome"
        ]
      },
      "then": {
        "required": [
          "tool",
          "level",
          "truncated",
          "bytes",
          "duration_ms",
          "attempts",
          "dedupe_key"
        ],
        "properties": {
          "attempts": {
            "enum": [
              1,
              2
            ]
          }
        },
        "not": {
          "required": [
            "rendered"
          ]
        }
      }
    },
    {
      "if": {
        "properties": {
          "outcome": {
            "const": "dry_run"
          }
        },
        "required": [
          "outcome"
        ]
      },
      "then": {
        "required": [
          "tool",
          "level",
          "truncated",
          "bytes",
          "duration_ms",
          "attempts",
          "dedupe_key",
          "rendered"
        ],
        "properties": {
          "attempts": {
            "type": "null"
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "outcome": {
            "const": "disabled"
          }
        },
        "required": [
          "outcome"
        ]
      },
      "then": {
        "maxProperties": 1
      }
    }
  ]
}
