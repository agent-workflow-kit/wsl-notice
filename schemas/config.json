{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "wsl-notice/config",
  "title": "wsl-notice config",
  "description": "~/.config/wsl-notice/config.yaml (XDG_CONFIG_HOME respected) plus config.d/*.yaml in lexical order; maps merge. Invalid config exits 2 (config_invalid), naming the key. Precedence: flags, then config, then defaults; there are no environment overrides.",
  "type": "object",
  "properties": {
    "enabled": {
      "type": "boolean",
      "default": true,
      "description": "false makes send exit 22."
    },
    "powershell_bin": {
      "type": "string",
      "pattern": "^/[^\\u0000\\\\]{1,4096}$",
      "default": "/mnt/c/Windows/System32/WindowsPowerShell/v1.0/powershell.exe",
      "description": "Absolute path of Windows PowerShell 5.1. No PATH search, no drive letters, no backslashes."
    },
    "app_id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9_.{}\\\\ -]{1,256}$",
      "default": "{1AC14E77-02E7-4E5D-B744-2EB1AE5198B7}\\WindowsPowerShell\\v1.0\\powershell.exe",
      "description": "Application identity the toast is shown under. The default is the Windows PowerShell identity, which needs no registration. An unregistered identity gives no error and may show nothing."
    },
    "level_prefix": {
      "type": "object",
      "properties": {
        "info": {
          "type": "string",
          "maxLength": 16,
          "pattern": "^[^\\u0000-\\u001f\\u007f\\u0080-\\u009f\\u200b-\\u200f\\u2028-\\u202e\\u2060-\\u2069\\ufeff]*$"
        },
        "warn": {
          "type": "string",
          "maxLength": 16,
          "pattern": "^[^\\u0000-\\u001f\\u007f\\u0080-\\u009f\\u200b-\\u200f\\u2028-\\u202e\\u2060-\\u2069\\ufeff]*$"
        },
        "action": {
          "type": "string",
          "maxLength": 16,
          "pattern": "^[^\\u0000-\\u001f\\u007f\\u0080-\\u009f\\u200b-\\u200f\\u2028-\\u202e\\u2060-\\u2069\\ufeff]*$"
        },
        "error": {
          "type": "string",
          "maxLength": 16,
          "pattern": "^[^\\u0000-\\u001f\\u007f\\u0080-\\u009f\\u200b-\\u200f\\u2028-\\u202e\\u2060-\\u2069\\ufeff]*$"
        }
      },
      "additionalProperties": false,
      "default": {
        "info": "",
        "warn": "WARN:",
        "action": "ACTION:",
        "error": "ERROR:"
      },
      "description": "Title prefix per level, one line of at most 16 characters. Maps merge across drop-ins. Values the sanitizer would change are config_invalid."
    },
    "max_title": {
      "type": "integer",
      "minimum": 20,
      "maximum": 256,
      "default": 100
    },
    "max_body": {
      "type": "integer",
      "minimum": 100,
      "maximum": 5000,
      "default": 1000
    },
    "timeout": {
      "$ref": "#/$defs/duration",
      "default": "10s"
    },
    "link_hosts": {
      "type": "array",
      "minItems": 1,
      "maxItems": 32,
      "items": {
        "type": "string",
        "pattern": "^[a-z0-9.-]{1,253}$"
      },
      "description": "Optional, unset by default. When set, a link's host (lowercased, no port) must equal an entry or end with '.' plus an entry, else exit 20 link_invalid."
    },
    "log": {
      "type": "boolean",
      "default": true,
      "description": "false writes no log.jsonl."
    }
  },
  "additionalProperties": false,
  "required": [],
  "$defs": {
    "duration": {
      "anyOf": [
        {
          "type": "number",
          "minimum": 5,
          "maximum": 60
        },
        {
          "type": "string",
          "pattern": "^0*(?:(?:[5-9]|[1-5][0-9])(?:\\.[0-9]+)?|60(?:\\.0+)?)s?$"
        },
        {
          "type": "string",
          "pattern": "^0*1(?:\\.0+)?m$"
        },
        {
          "type": "string",
          "pattern": "^0*(?:[5-9][0-9]{3}|[1-5][0-9]{4}|60000)(?:\\.0+)?ms$"
        }
      ],
      "description": "Seconds as a number from 5 to 60, or a string matching [0-9]+(\\.[0-9]+)?(ms|s|m)? (no unit means seconds; no h or d). The schema checks the 5s to 60s range for common forms and the tool checks it exactly (false for NaN)."
    }
  }
}
